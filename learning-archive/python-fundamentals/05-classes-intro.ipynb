   "source": [
    "class Animal:\n",
    "    def __init__(self,species, age):\n",
    "        self.species = species\n",
    "        self.age = age\n",
    "    def describe(self):\n",
    "        return f\"this animal is a {self.species} and is a {self.age} years old.\"\n",
    "my_animal = Animal(\"Lion\",5)\n",
    "print(my_animal.describe())"
   ]
